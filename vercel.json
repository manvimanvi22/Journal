{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/entries/([^/]+)", "dest": "/api/entries/[id].js" },
    { "src": "/api/ai/reflection", "dest": "/api/ai/reflection.js" },
    { "src": "/api/entries", "dest": "/api/entries.js" },
    { "src": "/api/stats", "dest": "/api/stats.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}